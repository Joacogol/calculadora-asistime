__pycache__/
*.pyc

# El estado del alta de cada cliente lleva sus claves. Nunca al repo.
worker/.claude/skills/*/alta.json
# Enlaces que crea alta.py para el CLI de Supabase.
worker/supabase/
# Las fotos del banco las baja `app/banco.py` de la tabla del cliente en cada
# corrida. No son del repositorio: son del cliente, cambian sin que nadie
# commitee y pesan. Ver el encabezado de app/banco.py.
worker/.claude/skills/*/assets/banco/
# Y lo que sube una persona para UNA pieza, que baja `_traer_adjuntos`.
worker/.claude/skills/*/assets/subidas/

# Secretos y artefactos de ejecución.
.env
.env.*
!.env.example
credenciales.json
deploy/hetzner/config/
*.log
